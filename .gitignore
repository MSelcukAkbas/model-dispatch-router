# --- SECRETS ---------------------------------------------------------------
# miras.claude carries a plaintext DeepSeek API key in two places:
#   skills/model-dispatch/scripts/accounts.sh  (ACCOUNT_ANTHROPIC_AUTH_TOKEN)
#   claude-deepseek.bat                        (ANTHROPIC_AUTH_TOKEN)
# Never track these. Ignoring them here does NOT make the key safe — it is
# still in plaintext on disk and must be rotated and moved to an env var.
miras.claude/
miras.remember/

